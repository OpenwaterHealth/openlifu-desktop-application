/* Application-wide font */
* { font-family: "Segoe UI", sans-serif; }

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox {
  background-color: #222222;
  border: 1px solid #999999;
  border-radius: 4px;
  padding: 3px 6px;
  color: #FFFFFF;
}
QLineEdit:focus { border: 1px solid #BDC3C7; }

QLineEdit { selection-background-color: #269cf6; selection-color: #FFFFFF; }
QComboBox QLineEdit { selection-background-color: #3A3A3E; selection-color: #FFFFFF; }

QComboBox {
  background-color: #424242;
  border: 1px solid #999999;
  border-radius: 4px;
  padding: 3px 6px;
  color: #FFFFFF;
}
QComboBox:focus { border: 1px solid #BDC3C7; }

QComboBox::drop-down { border: none; width: 20px; }

/* Qt stops drawing the native arrow as soon as ::drop-down is styled above.
   %ICONS_DIR% is substituted with an absolute, on-disk path in
   HomeWidget.applyApplicationStyle() before this stylesheet is applied. */
QComboBox::down-arrow {
  image: url(%ICONS_DIR%/ArrowDown.png);
  width: 10px;
  height: 6px;
  margin-right: 6px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 16px;
  border: none;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 16px;
  border: none;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  image: url(%ICONS_DIR%/ArrowUp.png);
  width: 8px;
  height: 5px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  image: url(%ICONS_DIR%/ArrowDown.png);
  width: 8px;
  height: 5px;
}

QComboBox QAbstractItemView {
  background-color: #424242;
  border: 1px solid #3E4E6F;
  outline: none;
  selection-background-color: rgba(255, 255, 255, 30);
  selection-color: #FFFFFF;
}
QComboBox QAbstractItemView::item {
  padding: 4px 8px;
  color: #FFFFFF;
}
QComboBox QAbstractItemView::item:hover {
  background-color: rgba(255, 255, 255, 30);
}

/* Tables/trees/lists 
  Styling based on openlifu-test-app's Support Diagnostics table.

  Note:  alternate-background-color only takes effect on widgets 
  that have setAlternatingRowColors(True) set in
  UI file — this rule doesn't turn that behavior on by itself.
  The alternate color is very subtle */
QTableWidget, QTableView, QTreeView, QListWidget {
  background-color: #1E1E20;
  alternate-background-color: #232325;
  border: 1px solid #3E4E6F;
  border-radius: 6px;
  gridline-color: transparent;
  color: #ECEFF1;
  outline: none;
}
QTableWidget::item, QTreeView::item, QListWidget::item {
  padding: 4px 8px;
  border: none;
}
QTableWidget::item:selected, QTreeView::item:selected, QListWidget::item:selected {
  background-color: #269cf6;
  color: #FFFFFF;
}
QHeaderView::section {
  background-color: #2C3E50;
  color: #BDC3C7;
  font-weight: bold;
  padding: 3px 6px;
  border: none;
  border-bottom: 1px solid #3E4E6F;
}
QTableCornerButton::section {
  background-color: #2C3E50;
  border: none;
}

/* QGroupBox — thinner, light gray outline */
QGroupBox {
  background-color: #1E1E20;
  border: 1px solid #BDC3C7;
  border-radius: 10px;
  margin-top: 10px;
  padding-top: 8px;
  font-weight: bold;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
  color: #BDC3C7;
}

/* Collapsible section header */
ctkCollapsibleButton {
  background-color: #222732;
  border: 1px solid #3E4E6F;
  border-radius: 4px;
  color: #FFFFFF;
  font-weight: bold;
  padding: 4px 8px;
}
ctkCollapsibleButton:hover {
  background-color: #2A2F3A;
}

/* Buttons — neutral gray by default.
    Color-coded success/danger variants are opt-in via the
   cssClass dynamic property, for actions that want to stand out. */
QPushButton {
  background-color: #3A3F4B;
  border: 1px solid #BDC3C7;
  border-radius: 6px;
  min-height: 22px;
  padding: 0 8px;
  color: #FFFFFF;
}
QPushButton:hover    { background-color: #454B59; }
QPushButton:pressed  { background-color: #2F333D; }
QPushButton:disabled { background-color: #2A2C31; color: #888888; border-color: #55606E; }

QPushButton[cssClass~="button--success"] {
  background-color: #1f963d;
  border-color: #0E5A23;
}
QPushButton[cssClass~="button--success"]:hover    { background-color: #26b048; }
QPushButton[cssClass~="button--success"]:pressed  { background-color: #157031; }
QPushButton[cssClass~="button--success"]:disabled { background-color: #2A4030; color: #9CB8A4; border-color: #0E5A23; }

QPushButton[cssClass~="button--danger"] {
  background-color: #C0392B;
  border-color: #7A1F1F;
}
QPushButton[cssClass~="button--danger"]:hover    { background-color: #D0453A; }
QPushButton[cssClass~="button--danger"]:pressed  { background-color: #8E1F1F; }
QPushButton[cssClass~="button--danger"]:disabled { background-color: #3A2424; color: #B89A9A; border-color: #7A1F1F; }

/* Slice + 3D view controller bars — neutral gray-blue instead of
   Slicer's default per-view colors, with the same rounded
   frame-outline treatment as the rest of the panels in this theme. */
qMRMLSliceControllerWidget QWidget#BarWidget,
qMRMLThreeDViewControllerWidget QWidget#BarWidget {
  background-color: #3E4E6F;
  border: 1px solid #BDC3C7;
  border-radius: 6px;
  margin: 2px;
}

/* The slice-position spinbox ("S:"/"A:"/"L:" + offset value) picked up
   the general QDoubleSpinBox rounded-frame styling from the Inputs
   section above since it's rendered by a real QAbstractSpinBox nested
   inside qMRMLSliderWidget#SliceOffsetSlider — reset it to a plain,
   frameless label-like look instead. */
qMRMLSliderWidget#SliceOffsetSlider QAbstractSpinBox {
  border: none;
  background: transparent;
  border-radius: 0;
}
