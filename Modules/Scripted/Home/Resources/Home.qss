/* Inputs */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
  background-color: #222222;
  border: 1px solid #999999;
  border-radius: 4px;
  padding: 3px 6px;
  color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus { border: 1px solid #BDC3C7; }

/* Text-selection color only makes sense for the editable QLineEdit —
   applying it to QComboBox/QSpinBox too was bleeding blue into their
   (non-text-selection) highlight rendering. Also re-pin it to gray for
   a QComboBox's own internal line edit (when editable), so typing in
   an editable combo box doesn't show the standalone-field blue either. */
QLineEdit { selection-background-color: #269cf6; selection-color: #FFFFFF; }
QComboBox QLineEdit { selection-background-color: #3A3A3E; selection-color: #FFFFFF; }

QComboBox::drop-down { border: none; width: 20px; }

/* QGroupBox — thinner, light gray outline */
QGroupBox {
  background-color: #1E1E20;
  border: 1px solid #BDC3C7;
  border-radius: 10px;
  margin-top: 10px;
  padding-top: 8px;
  font-weight: bold;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
  color: #BDC3C7;
}

/* Collapsible section header */
ctkCollapsibleButton {
  background-color: #222732;
  border: 1px solid #3E4E6F;
  border-radius: 4px;
  color: #FFFFFF;
  font-weight: bold;
  padding: 4px 8px;
}
ctkCollapsibleButton:hover {
  background-color: #2A2F3A;
}

/* Buttons — neutral gray by default.
    Color-coded success/danger variants are opt-in via the
   cssClass dynamic property, for actions that want to stand out. */
QPushButton {
  background-color: #3A3F4B;
  border: 1px solid #BDC3C7;
  border-radius: 6px;
  min-height: 22px;
  padding: 0 8px;
  color: #FFFFFF;
}
QPushButton:hover    { background-color: #454B59; }
QPushButton:pressed  { background-color: #2F333D; }
QPushButton:disabled { background-color: #2A2C31; color: #888888; border-color: #55606E; }

QPushButton[cssClass~="button--success"] {
  background-color: #1f963d;
  border-color: #0E5A23;
}
QPushButton[cssClass~="button--success"]:hover    { background-color: #26b048; }
QPushButton[cssClass~="button--success"]:pressed  { background-color: #157031; }
QPushButton[cssClass~="button--success"]:disabled { background-color: #2A4030; color: #9CB8A4; border-color: #0E5A23; }

QPushButton[cssClass~="button--danger"] {
  background-color: #C0392B;
  border-color: #7A1F1F;
}
QPushButton[cssClass~="button--danger"]:hover    { background-color: #D0453A; }
QPushButton[cssClass~="button--danger"]:pressed  { background-color: #8E1F1F; }
QPushButton[cssClass~="button--danger"]:disabled { background-color: #3A2424; color: #B89A9A; border-color: #7A1F1F; }

/* Slice + 3D view controller bars — neutral gray-blue instead of
   Slicer's default per-view colors, with the same rounded
   frame-outline treatment as the rest of the panels in this theme. */
qMRMLSliceControllerWidget QWidget#BarWidget,
qMRMLThreeDViewControllerWidget QWidget#BarWidget {
  background-color: #3E4E6F;
  border: 1px solid #BDC3C7;
  border-radius: 6px;
  margin: 2px;
}

/* The slice-position spinbox ("S:"/"A:"/"L:" + offset value) picked up
   the general QDoubleSpinBox rounded-frame styling from the Inputs
   section above since it's rendered by a real QAbstractSpinBox nested
   inside qMRMLSliderWidget#SliceOffsetSlider — reset it to a plain,
   frameless label-like look instead. */
qMRMLSliderWidget#SliceOffsetSlider QAbstractSpinBox {
  border: none;
  background: transparent;
  border-radius: 0;
}
